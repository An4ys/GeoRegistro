<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/boton_historial"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvItemTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Título de Ejemplo"
            android:textColor="@color/texto_oscuro"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Categoría"
            android:textColor="@color/texto_oscuro"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvItemFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha: 19/10/2026 12:00"
            android:textColor="@color/texto_oscuro"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvItemCoordenadas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lat: -36.0, Lon: -72.0"
            android:textColor="@color/texto_oscuro"
            android:textSize="12sp"
            android:textStyle="italic" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>