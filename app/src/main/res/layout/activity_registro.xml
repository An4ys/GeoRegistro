<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pastel"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva Incidencia"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/texto_oscuro"
            android:layout_marginBottom="24dp"
            android:layout_gravity="center_horizontal" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxStrokeColor="@color/texto_oscuro">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Título de la incidencia *"
                android:textColor="@color/texto_oscuro" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxStrokeColor="@color/texto_oscuro">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Categoría *"
                android:textColor="@color/texto_oscuro" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxStrokeColor="@color/texto_oscuro">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Descripción detallada"
                android:lines="3"
                android:gravity="top"
                android:textColor="@color/texto_oscuro" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxStrokeColor="@color/texto_oscuro">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFechaHora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Fecha y Hora *"
                android:enabled="false"
                android:textColor="@color/texto_oscuro" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:boxStrokeColor="@color/texto_oscuro">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCoordenadas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Coordenadas GPS *"
                android:enabled="false"
                android:textColor="@color/texto_oscuro" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvSensorValores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sensor: Iniciando..."
            android:textColor="@color/texto_oscuro"
            android:textStyle="italic"
            android:layout_marginBottom="24dp"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarIncidencia"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Guardar Incidencia"
            android:textColor="@color/texto_oscuro"
            android:textSize="16sp"
            app:backgroundTint="@color/boton_registro"
            app:cornerRadius="16dp" />

    </LinearLayout>
</ScrollView>