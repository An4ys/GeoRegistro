<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/fondo_pastel">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/logo_app"
        android:layout_marginBottom="16dp"
        android:contentDescription="Logo de la aplicación" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GeoRegistro"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="@color/texto_oscuro"
        android:layout_marginBottom="48dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNuevoRegistro"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="Nuevo Registro"
        android:textColor="@color/texto_oscuro"
        android:textSize="16sp"
        app:icon="@drawable/ic_registro"
        app:iconTint="@color/texto_oscuro"
        app:iconGravity="start"
        android:gravity="center_vertical|start"
        android:paddingStart="80dp"
        app:iconPadding="16dp"
        app:backgroundTint="@color/boton_registro"
        app:cornerRadius="16dp"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerHistorial"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="Ver Historial"
        android:textColor="@color/texto_oscuro"
        android:textSize="16sp"
        app:icon="@drawable/ic_historial"
        app:iconTint="@color/texto_oscuro"
        app:iconGravity="start"
        android:gravity="center_vertical|start"
        android:paddingStart="80dp"
        app:iconPadding="16dp"
        app:backgroundTint="@color/boton_historial"
        app:cornerRadius="16dp"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerMapa"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="Mapa de Incidencias"
        android:textColor="@color/texto_oscuro"
        android:textSize="16sp"
        app:icon="@drawable/ic_mapa"
        app:iconTint="@color/texto_oscuro"
        app:iconGravity="start"
        android:gravity="center_vertical|start"
        android:paddingStart="80dp"
        app:iconPadding="16dp"
        app:backgroundTint="@color/boton_mapa"
        app:cornerRadius="16dp" />

</LinearLayout>